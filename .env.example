# Backblaze B2 (required) — S3-compatible credentials
B2_APPLICATION_KEY_ID=your_key_id
B2_APPLICATION_KEY=your_application_key
B2_BUCKET_NAME=your-bucket-name

# B2 region slug. The S3 endpoint is derived as
# https://s3.<B2_REGION>.backblazeb2.com — do NOT put a full URL here.
B2_REGION=us-west-004

# Optional: public base URL for building object links shown in the UI.
# Leave blank to disable public links (the app uses presigned URLs regardless).
B2_PUBLIC_URL_BASE=

# Example of what filled-in values look like (fake — for visual reference only):
# B2_APPLICATION_KEY_ID=000000abcdef00000000001
# B2_APPLICATION_KEY=example-fake-application-key-value
# B2_BUCKET_NAME=my-archive-scans
# B2_REGION=us-west-004
# B2_PUBLIC_URL_BASE=https://my-archive-scans.s3.us-west-004.backblazeb2.com
