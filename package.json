{
  "name": "paddleocr-document-archive",
  "private": true,
  "scripts": {
    "doctor": "node scripts/doctor.mjs",
    "predev": "node scripts/doctor.mjs",
    "dev": "sh scripts/dev.sh",
    "dev:web": "pnpm --filter @paddleocr-document-archive/web dev",
    "dev:api": "docker compose up --build api",
    "dev:api:down": "docker compose down",
    "build": "pnpm --filter @paddleocr-document-archive/web build",
    "typecheck": "pnpm --filter @paddleocr-document-archive/web typecheck",
    "lint": "pnpm --filter @paddleocr-document-archive/web lint",
    "lint:api": "cd services/api && .venv/bin/ruff check .",
    "test:api": "cd services/api && .venv/bin/python -m pytest",
    "check:structure": "cd services/api && .venv/bin/python -m pytest tests/test_structure.py -v",
    "test:e2e": "pnpm --filter @paddleocr-document-archive/web exec playwright test"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "pnpm": {
    "overrides": {
      "@babel/core": "7.29.6",
      "@hono/node-server": "1.19.15",
      "ajv@^6": "6.14.0",
      "ajv@^8": "8.18.0",
      "body-parser": "2.3.0",
      "brace-expansion@^1": "1.1.18",
      "brace-expansion@^2": "2.1.4",
      "brace-expansion@^5": "5.0.9",
      "express-rate-limit": "8.2.2",
      "fast-uri": "3.1.8",
      "flatted": "3.4.2",
      "hono": "4.12.34",
      "@humanfs/node": "0.16.8",
      "ip-address": "10.3.1",
      "js-yaml": "4.3.1",
      "lodash": "4.18.0",
      "minimatch": "10.2.3",
      "nanoid": "3.3.18",
      "path-to-regexp": "8.4.0",
      "picomatch": "4.0.4",
      "postcss": "8.5.23",
      "postcss-selector-parser": "7.1.3",
      "browserslist": "4.28.8",
      "qs": "6.16.0",
      "sharp": "0.35.0",
      "shell-quote": "1.9.0"
    }
  }
}
